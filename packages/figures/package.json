{
  "name": "@nettohelder/figures",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "default": "./src/browser.ts"
    },
    "./catalog": {
      "types": "./src/cao-catalog.ts",
      "default": "./src/cao-catalog.ts"
    },
    "./source-policy": {
      "types": "./src/source-policy.ts",
      "default": "./src/source-policy.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "gen": "tsx scripts/gen-cao-index.ts",
    "build": "tsx scripts/gen-cao-index.ts && tsc",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^2.1.0"
  }
}
